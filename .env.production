# Build-time defaults for the deployed app.
#
# Both values are public by design: Vite inlines them into the browser bundle,
# so every visitor receives them anyway. The publishable key grants nothing on
# its own — row-level security decides what it can read and write. Committing
# them means a connected Cloudflare build needs no configuration to produce a
# working app.
#
# The service-role key is the opposite and is never here: it bypasses RLS, it
# lives only in the Worker's secrets, and it never reaches the browser.
#
# Dashboard build variables of the same name override these.
VITE_SUPABASE_URL="https://enivasukccwjpvsgwcsd.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_czYGhbRPLtNUe4OwEGSZ8g_up56uvYB"
